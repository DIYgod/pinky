    "1. Open Settings › Privacy & Security › Developer Mode." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 「設定 › プライバシーとセキュリティ › デベロッパモード」を開きます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Mở Cài đặt › Quyền riêng tư & Bảo mật › Chế độ nhà phát triển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 打开「设置 › 隐私与安全性 › 开发者模式」。"
          }
        }
      }
    },
    "2. Choose to pair with “Pinky”." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 「Pinky」とのペアリングを選びます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Chọn ghép nối với “Pinky”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 选择与「Pinky」配对。"
          }
        }
      }
    },
    "3. Type the code below. It also comes as a notification." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 下のコードを入力します。コードは通知でも届きます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Nhập mã bên dưới. Nó cũng đến dưới dạng một thông báo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 输入下面的配对码。配对码也会以通知的形式出现。"
          }
        }
      }
    },
