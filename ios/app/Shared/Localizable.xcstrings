{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ tokens" : {
      "comment" : "A number of tokens a model read and wrote",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ トークン"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 个 token"
          }
        }
      }
    },
    "%@. %@" : {
      "comment" : "How a task ended, then why",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：%2$@"
          }
        }
      }
    },
