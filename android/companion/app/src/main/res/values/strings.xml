    <string name="app_name">Pinky Companion</string>
    <string name="service_label">Pinky Companion</string>
    <string name="service_description">Lets Pinky on your computer read the controls on the screen and type text while an agent task runs. Pinky turns this service on over USB debugging only for the task and turns it off afterwards. It also turns itself off after a few minutes without a connection.</string>

    <string name="title">Pinky Companion</string>
    <string name="intro">Pinky turns this service on through adb while an agent task runs and off when the task ends. Nothing here needs to be set up by hand.</string>
